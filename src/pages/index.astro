---
import '../styles/tokens.css';
import '../styles/fonts.css';

/*
 * PLACEHOLDER COPY — the prose in `intro`, `projects` and `elsewhere` is a
 * stand-in for Garrett to rewrite. The facts (stack, the $360K figure, the
 * 1,400+ sites) come from the brief; the sentences around them do not.
 *
 * Project links and titles are real. Capital One carries none by design: that
 * work is not Garrett's to publish.
 *
 * `contact` is real and should not be treated as placeholder.
 */

// BASE_URL carries no trailing slash when `base` has none, so strip any and
// rejoin explicitly. Works for a project page and for base '/' alike.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = 'Garrett Franklin';
const description =
  'Garrett Franklin. Graphics, games, and the systems underneath them. ' +
  'Computer science and math at the University of Maryland.';
// Absolute, as crawlers require. public/og.png is a 1200x630 capture of the hero.
const ogImage = new URL('og.png', Astro.site).href;

const intro = {
  name: 'Garrett Franklin',
  does: 'I build graphics, games, and the systems underneath them. Computer science and math at the University of Maryland, class of 2027.',
  now: "This fall I'm at Zipline, working on Maps & Routing.",
  terrain: 'The landscape here is a toy version of that problem: the ground is generated as you watch, and the line across it is replanned every time the ground moves.',
};

const projects = [
  {
    title: 'Capital One ML pipeline',
    context: 'internship',
    summary: 'Gradient-boosted models that pick the right AWS Glue configuration for a job.',
    body: 'Glue jobs were provisioned by hand and almost always over-provisioned. I trained XGBoost and LightGBM models on historical run telemetry to predict the cheapest configuration that still met the runtime target, and shipped them behind Lambda with feature flags so a bad model could be turned off without a deploy. The hard part was not the model — it was drift: job shapes changed weekly, so the pipeline needed drift detection and automated retraining to keep up. Projected annual savings came in above $360K.',
    // Nothing to link: the work is not Garrett's to publish.
    links: [],
  },
  {
    title: 'AliasGraph',
    context: 'personal',
    summary: 'OSINT tool that clusters one person’s accounts across the web.',
    body: 'AliasGraph checks a username against more than 1,400 sites concurrently and then tries to work out which of the hits are actually the same person. The scraping was mostly a rate-limiting and backpressure problem. The harder part was the clustering: turning weak, noisy signals into a graph and partitioning it without collapsing two different people into one identity.',
    links: [['source', 'https://github.com/gfranklin1/osint-username-enumerator']],
  },
  {
    title: 'Depth & Doubloons',
    context: 'game jam',
    summary: 'Co-op diving game in Unity: one player sails the ship, the other goes over the side on a tether.',
    body: "Authority ended up split rather than uniform: the ship simulates on the server and takes steering as RPCs, while each diver's state replicates from the client that owns it. The seabed is generated from a seed the server shares, so every client rebuilds the same chunks as the ship moves.",
    links: [
      ['source', 'https://github.com/gfranklin1/UMD-Spring-2026-Game-Jam'],
      ['demo', 'https://brokens.itch.io/depth-and-doubloons'],
    ],
  },
  {
    title: 'Tron XR',
    context: 'xr club',
    summary: 'Mixed-reality combat for Quest 3, where the enemies come out of your actual walls.',
    body: "The room scan isn't a backdrop: it's turned into destructible segments, so a thrown disk breaks the wall it hits and enemies come in through the hole. There's no navmesh, since every scanned room is different, so each bug re-snaps to the surface under it every tick and steers along it, which is what lets it crawl up a wall and hang off the ceiling. The wall-avoidance raycast did more than I planned: a destroyed segment leaves no collider, so a breach reads as open space and the bugs funnel through the holes you made without any pathfinding that knows holes exist.",
    links: [['source', 'https://github.com/andydiep04/tron_xr']],
  },
  {
    title: 'LastMile',
    context: 'personal',
    summary: 'Delivery dispatch and a live map: Go services, a Neo4j driver graph, a React dashboard.',
    body: "Each Driver node carries the end of its route, not just where the driver is now, so one Cypher query ranks every candidate by what appending an order would actually cost instead of the coordinator pulling routes into application code to sort them. Nothing moves in the backend, though: positions are written once, so the realtime service animates the markers in memory and never writes back, and a restart re-anchors them to the cached truth.",
    links: [['source', 'https://github.com/bengal-tech365/LastMile']],
  },
];

const history = [
  ['zipline', 'maps & routing', 'fall 2026'],
  ['capital one', 'ml infrastructure', 'summer 2026'],
  ['whiting-turner', 'data analytics', 'summer 2025'],
];

const elsewhere =
  'I help run the Claude Builders Club at Maryland, and I am a member of UMD Game Dev and the XR Club. Most of what I make outside classes starts in one of those rooms.';

const contact = [
  ['email', 'garrettfranklin.careers@gmail.com', 'mailto:garrettfranklin.careers@gmail.com'],
  ['github', 'github.com/gfranklin1', 'https://github.com/gfranklin1'],
  ['linkedin', 'linkedin.com/in/garrettfranklin0', 'https://www.linkedin.com/in/garrettfranklin0/'],
  ['resume', 'resume.pdf', `${base}/resume.pdf`],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href={`${base}/fonts/newsreader-var-opsz-400-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}/fonts/ibm-plex-mono-400-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <main>
      <section class="intro">
        <div class="intro-text">
          <h1>{intro.name}</h1>
          <p class="lede">{intro.does}</p>
          <p class="lede">{intro.now}</p>
          <p class="lede terrain-note">{intro.terrain}</p>
        </div>

        <div class="terrain" aria-hidden="true">
          <canvas id="terrain"></canvas>
        </div>
      </section>

      <section class="history">
        <p class="label">work</p>
        <ul>
          {history.map(([org, role, when]) => (
            <li>
              <span class="org">{org}</span>
              <span class="role">{role}</span>
              <span class="when">{when}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="work">
        <p class="label">selected work</p>
        {projects.map((p) => (
          <article>
            <h2>{p.title}</h2>
            <p class="summary">{p.summary}</p>
            <p class="body">{p.body}</p>
            <p class="meta">
              <span class="ctx">{p.context}</span>
              {p.links.length > 0 && (
                <span class="links">
                  {p.links.map(([name, href], i) => (
                    <>
                      {i > 0 && <span class="sep"> / </span>}
                      <a href={href}>{name}</a>
                    </>
                  ))}
                </span>
              )}
            </p>
          </article>
        ))}
      </section>

      <section class="now">
        <p class="label">now / elsewhere</p>
        <p class="body">{elsewhere}</p>
      </section>

      <section class="contact">
        <p class="label">contact</p>
        <ul>
          {contact.map(([name, text, href]) => (
            <li>
              <span class="key">{name}</span>
              <a href={href}>{text}</a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <script>
      import '../terrain/home';
    </script>

    <style>
      /* The terrain runs out to the viewport edge; belt and braces so that
         bleed can never turn into a horizontal scrollbar. */
      html,
      body {
        overflow-x: clip;
      }

      /* First-column measure shared by the work block and the project meta
         rows, in px so it does not shift with either row's font size. */
      main {
        --meta-col: 153px;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 40px 200px;
      }

      /* intro ------------------------------------------------------------ */

      .intro {
        position: relative;
        min-height: 88vh;
        display: flex;
        align-items: center;
      }

      /*
       * The terrain sits behind the intro, pushed right so the type never
       * lands on lit ground. There is no scrim holding the text up — gradients
       * are out — so the separation has to come from the composition itself.
       */
      .terrain {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        /*
         * Stop exactly at the viewport's right edge — no overhang. The slab is
         * scaled down in the camera instead (see setFramingScale in home.ts),
         * which keeps its right and bottom edges inside the frame rather than
         * running them off it. Bleeding off the top is fine and intended.
         */
        right: calc(50% - 50vw);
        pointer-events: auto;
      }

      #terrain {
        display: block;
        width: 100%;
        height: 100%;
      }

      .intro-text {
        position: relative;
        z-index: 1;
        max-width: var(--measure);
        pointer-events: none;
      }

      h1 {
        font-family: var(--serif);
        font-optical-sizing: auto;
        font-size: clamp(44px, 6.4vw, 78px);
        font-weight: 400;
        letter-spacing: -0.028em;
        line-height: 1;
        margin: 0 0 36px;
      }

      .lede {
        font-family: var(--serif);
        font-optical-sizing: auto;
        font-size: clamp(19px, 1.55vw, 22px);
        line-height: 1.58;
        letter-spacing: -0.003em;
        color: var(--paper-80);
        margin: 0 0 18px;
        max-width: 40ch;
      }

      .terrain-note {
        color: var(--paper-50);
      }

      /* sections --------------------------------------------------------- */

      section + section {
        margin-top: 168px;
      }

      /*
       * The hero is a full screen tall but the slab stops well short of its
       * bottom edge, leaving dead canvas underneath. Pull the next section up
       * into that space so the work block starts just below the terrain rather
       * than below the empty box around it. Negative because the hero's height
       * sets the canvas aspect, and shortening it would resize the slab.
       */
      /*
       * Desktop only: below the breakpoint the canvas is a block in normal
       * flow, and this would drag the work block up underneath it, hiding the
       * label and the first row.
       */
      @media (min-width: 901px) {
        .intro + section {
          margin-top: -68px;
        }
      }

      .work article + article {
        margin-top: 104px;
      }

      /* The work block reads as part of the same run as the projects, so it
         gets the gap between projects rather than the gap between sections. */
      .history + .work {
        margin-top: 104px;
      }

      h2 {
        font-family: var(--serif);
        font-optical-sizing: auto;
        font-size: clamp(27px, 2.5vw, 33px);
        font-weight: 400;
        letter-spacing: -0.018em;
        line-height: 1.15;
        margin: 0 0 12px;
      }

      .summary {
        font-family: var(--serif);
        font-optical-sizing: auto;
        font-size: 19px;
        line-height: 1.5;
        color: var(--paper-80);
        margin: 0 0 22px;
        max-width: var(--measure);
      }

      .body {
        font-family: var(--serif);
        font-optical-sizing: auto;
        font-size: 18px;
        line-height: 1.72;
        margin: 0;
        max-width: var(--measure);
        color: var(--paper-80);
      }

      .sep {
        color: var(--paper-35);
      }

      /* work history ------------------------------------------------------ */

      /* Three aligned columns, same construction as the contact block: a fixed
         measure per column so the rows line up without a table or a grid. */
      .history ul,
      .contact ul {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 15px;
      }

      .history li,
      .contact li {
        display: flex;
        gap: 20px;
        margin-bottom: 8px;
      }

      .history .org {
        min-width: var(--meta-col);
      }

      .history .role {
        min-width: 22ch;
        color: var(--paper-80);
      }

      .history .when {
        color: var(--paper-35);
      }

      /*
       * One dim mono row closing each project: what it was, then where to find
       * it. The context column is the same measure as the work block's first
       * column, so the links line up with the roles above them.
       */
      .meta {
        display: flex;
        gap: 20px;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--paper-35);
        margin: 22px 0 0;
      }

      .meta .ctx {
        min-width: var(--meta-col);
      }

      /* contact ---------------------------------------------------------- */

      .key {
        color: var(--paper-35);
        min-width: 9ch;
      }

      /* narrow ----------------------------------------------------------- */

      @media (max-width: 900px) {
        main {
          padding: 0 24px 120px;
        }

        /*
         * Below this width there is no column of empty ground to put type
         * over, so the terrain stops being a backdrop and becomes a block
         * under the intro.
         */
        .intro {
          display: block;
          min-height: 0;
          padding-top: 64px;
        }

        /*
         * Shorter than the desktop hero. A tall narrow canvas has a low
         * aspect, which makes the camera dolly back to fit and strands the
         * slab in empty ground above and below; wider than tall keeps it
         * filling the frame.
         */
        .terrain {
          position: static;
          height: 34vh;
          min-height: 220px;
          max-height: 300px;
          margin: 36px -24px 0;
        }

        .lede {
          max-width: none;
        }

        /* One step down so a work row fits the viewport with margin. */
        .history ul,
        .contact ul {
          font-size: 13px;
        }

        /* Three columns will not fit; let each row wrap and drop the measures. */
        .history li {
          flex-wrap: wrap;
          gap: 4px 14px;
        }

        .history .org,
        .history .role,
        .meta .ctx {
          min-width: 0;
        }

        section + section {
          margin-top: 104px;
        }

        .work article + article {
          margin-top: 72px;
        }
      }
    </style>
  </body>
</html>
